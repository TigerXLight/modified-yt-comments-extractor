@echo off
setlocal
cd /d "%~dp0..\.."
echo [R42DN] Building active worker/source upload ZIP...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; Add-Type -AssemblyName System.IO.Compression.FileSystem; $root=(Get-Location).Path; $stamp=Get-Date -Format 'yyyyMMdd_HHmmss'; $outRoot=Join-Path $root 'profile_media_live_captures\r42dn_normal_access_first_universal_layer'; $stage=Join-Path $env:TEMP ('r42dn_active_' + $stamp); if(Test-Path -LiteralPath $stage){Remove-Item -LiteralPath $stage -Recurse -Force}; New-Item -ItemType Directory -Force -Path $stage | Out-Null; $files=@('main.py','source_adapters.py','source_resource_state.py','profile_media_universal_source_link_adapter_r42dk.py','profile_media_universal_source_link_adapter_r42dl.py','profile_media_access_escalation_policy_r42dm.py','profile_media_normal_access_layer_r42dn.py','profile_media_link_source_details_role_matrix_v83d.py','profile_media_link_source_webpage_role_view_v83d.py','profile_media_link_source_real_webview_overlay_v83d.py'); foreach($rel in $files){ $src=Join-Path $root $rel; if(Test-Path -LiteralPath $src){ $dst=Join-Path $stage ('project\' + $rel); New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst) | Out-Null; Copy-Item -LiteralPath $src -Destination $dst -Force } }; $zip=Join-Path $outRoot ('r42dn_active_worker_source_upload_' + $stamp + '.zip'); New-Item -ItemType Directory -Force -Path $outRoot | Out-Null; if(Test-Path -LiteralPath $zip){Remove-Item -LiteralPath $zip -Force}; [System.IO.Compression.ZipFile]::CreateFromDirectory($stage,$zip); $dl=Join-Path $env:USERPROFILE ('Downloads\' + (Split-Path -Leaf $zip)); Copy-Item -LiteralPath $zip -Destination $dl -Force; Write-Host '[DONE] Created:' $zip; Write-Host '[DONE] Copied to Downloads:' $dl"
