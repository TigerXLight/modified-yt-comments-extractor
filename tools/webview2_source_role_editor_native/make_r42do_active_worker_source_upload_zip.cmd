@echo off
setlocal
cd /d "%~dp0..\.."
echo [R42DO] Building active worker/source-router source upload ZIP...
for /f %%i in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"') do set STAMP=%%i
set "OUTROOT=profile_media_live_captures\r42do_universal_worker_source_router"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; Add-Type -AssemblyName System.IO.Compression.FileSystem; $root=(Get-Location).Path; $stamp='%STAMP%'; $stage=Join-Path $env:TEMP ('r42do_active_' + $stamp); if(Test-Path -LiteralPath $stage){Remove-Item -LiteralPath $stage -Recurse -Force}; New-Item -ItemType Directory -Force -Path $stage | Out-Null; $files=@('main.py','source_adapters.py','source_resource_state.py','profile_media_universal_worker_source_router_r42do.py','profile_media_universal_worker_source_router_r42do_test.py','profile_media_normal_access_layer_r42dn.py','profile_media_access_escalation_policy_r42dm.py','profile_media_universal_source_link_adapter_r42dk.py','profile_media_universal_source_link_adapter_r42dl.py','profile_media_link_source_details_role_matrix_v83d.py','profile_media_link_source_webpage_role_view_v83d.py','profile_media_link_source_real_webview_overlay_v83d.py','profile_media_archive_material_chain_r42ct.py','profile_media_access_backend_router_r42ct.py','profile_media_tor_camoufox_material_backend_r42ct.py','profile_media_generic_website_live_capture.py','R42DO_UNIVERSAL_WORKER_SOURCE_ROUTER_NOTES_20260906.md'); foreach($rel in $files){ $src=Join-Path $root $rel; if(Test-Path -LiteralPath $src){ $dst=Join-Path $stage $rel; New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst) | Out-Null; Copy-Item -LiteralPath $src -Destination $dst -Force } }; $zip=Join-Path $root ('%OUTROOT%\r42do_active_worker_source_upload_' + $stamp + '.zip'); if(Test-Path -LiteralPath $zip){Remove-Item -LiteralPath $zip -Force}; [System.IO.Compression.ZipFile]::CreateFromDirectory($stage,$zip); $dl=Join-Path $env:USERPROFILE ('Downloads\' + (Split-Path -Leaf $zip)); Copy-Item -LiteralPath $zip -Destination $dl -Force; Write-Host '[DONE] Created ZIP:' $zip; Write-Host '[DONE] Copied ZIP to Downloads:' $dl"
